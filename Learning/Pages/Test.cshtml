@page
@model Learning.Pages.TestModel
@{
    ViewData["Title"] = "Làm bài thi";
}
<style>
    /* Spinner mặc định sẽ ẩn */
    .spinner {
        display: none;
        width: 1.2rem;
        height: 1.2rem;
        vertical-align: text-bottom;
        border: .2em solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-border .75s linear infinite;
        margin-left: 10px;
    }

    /* Quan trọng: Khi nút có class 'is-loading', spinner phải hiện */
    .btn.is-loading .spinner {
        display: inline-block !important;
    }

    @@keyframes spinner-border {
        to {
            transform: rotate(360deg);
        }
    }

    #loading.active {
        display: inline-block !important;
    }
</style>

<div class="container mt-5">
    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(Model.Picture))
            {
                <div class="text-center mb-4">
                    <img src="data:image/png;base64,@Model.Picture" class="img-fluid rounded-3 shadow-sm" style="max-height: 300px;" />
                </div>
            }

            <h4 class="fw-bold mb-4">Câu @(Model.currentIndex + 1): @Model.Content_Test</h4>

            <form method="post" asp-page-handler="Choice">
                @* Các input này cực kỳ quan trọng để giữ trạng thái điểm số và câu hỏi *@
                <input type="hidden" name="path" value="@Model.url" />
                <input type="hidden" name="currentIndex" value="@Model.currentIndex" />
                <input type="hidden" name="currentPoint" value="@Model.currentPoint" />
                <input type="hidden" name="correctText" value="@Model.current_Answer" />

                <div class="list-group">
                    @foreach (var item in Model.ShuffledAnswers)
                    {
                        <label class="list-group-item list-group-item-action d-flex align-items-center py-3">
                            <input class="form-check-input me-3" type="radio" asp-for="SelectedAnswer" value="@item.Value" required>
                            <span>@item.Value</span>
                        </label>
                    }
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" id="btnNext" class="btn btn-success d-flex align-items-center">
                        <span id="btnText">Câu tiếp theo</span>
                        <!-- Spinner này mặc định ẩn bằng class d-none của Bootstrap -->
                        <div id="loading" class="spinner-border spinner-border-sm ms-2 d-none" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    document.querySelector('form').onsubmit = function() {
        // 1. Hiện cái vòng quay
        const loading = document.getElementById('loading');
        loading.classList.add('show-loading');

        // 2. Đổi chữ nút bấm
        document.getElementById('btnText').innerText = "Đang xử lý...";

        // 3. Vô hiệu hóa nhấn chuột nhưng vẫn cho phép form gửi đi
        const btn = document.getElementById('btnNext');
        btn.style.pointerEvents = "none";
        btn.style.opacity = "0.7";
    };
</script>