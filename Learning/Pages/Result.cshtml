@page "{score}"
@model Learning.Pages.ResultModel
@{
    ViewData["Title"] = "Xem điểm";
}
<div>
    @if (@Model.Point>=5)
    {
        <h2>Chúc mừng bạn đã trên trung bình</h2>
    }
    @if (@Model.Point < 5)
    {
        <h2>Xin chia buồn</h2>
    }
    <p class="green_layout">
        Tên: @Model.UserName
    </p>

    <p class="display-3">
        Lớp: @Model.Class
    </p>

    <p class="display-3">
        Điểm: @Model.Point
    </p>
</div>
@section Scripts {
    <script type="text/javascript">
        // Vừa vào trang là khóa chặt lịch sử trình duyệt tại đây luôn
        function preventBack() {
            window.history.forward();
        }
        setTimeout("preventBack()", 0);
        window.onunload = function () { null };
    </script>
}
